{
  "name": "donna",
  "private": true,
  "description": "Donna: compliance advisor for people who build technology in Mexico (Hacktoberfest M\u00e9xico 2026)",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*",
    "frontend/lovable"
  ],
  "scripts": {
    "identity": "node packages/agent-client/scripts/build-identity.mjs",
    "dev": "npm run identity && npm run rules && npm run dev -w web",
    "build": "npm run identity && npm run build -w web",
    "start": "npm run start -w web",
    "lint": "npm run lint -w web",
    "test": "node --test packages/*/test/*.test.ts",
    "mock": "node mock/agent-mock.mjs",
    "rules": "node packages/rules-engine/scripts/build-rules.ts",
    "rules:import": "node packages/rules-engine/scripts/import-rules.ts",
    "dof:smoke": "node packages/dof/scripts/smoke.ts",
    "test:frontend": "npm run test -w @donna/frontend",
    "test:domain": "node --test scripts/domain.integration.test.mjs"
  },
  "engines": {
    "node": ">=22.18"
  }
}
